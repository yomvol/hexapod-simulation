{
	"name": "ros-jazzy-dev",
	"build": {
		"context": "..",
		"dockerfile": "../ros-jazzy-cuda.Dockerfile",
		"target": "dev"
	},
	"runArgs": [
		"--network=host",
		"--ipc=host",
		"--gpus",
		"all"
	],
	"workspaceMount": "source=${localWorkspaceFolder},target=/ros_ws/src/hexapod_simulation,type=bind,consistency=cached",
	"workspaceFolder": "/ros_ws",
	"mounts": [
		"source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind"
	],
	"containerEnv": {
		"DISPLAY": "${localEnv:DISPLAY}"
	}
}
